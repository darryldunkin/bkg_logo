/* [Personalization] */
// Your registered callsign
callsign = "KD9ZZK"; // 6
// Your BKG number
number = 14;         // [1:99999]
// The frequency to display
freq = "144.025";    // 8

/* [Sizing] */
// The size in mm
size = 70;           // [70:256]
// How thick to print in total
height = 2.5;        // [2:8]
// How tall the image is in comparison to the base
ratio = 0.7;         //[0.5:.9]

/* [Style] */
// Any attached accessories
type = "coin";       // [coin, chain, strap, buckle]
// How wide the strap is (for strap/buckle)
strap_width = 1;     // [0.25:3]

/* [Colors] */
// Base plate and accessories
clr_base = "#000000";      // color
// Text
clr_text = "#FFFFFF";      // color
// Highlights
clr_highlights = "#7F7E83";// color
// Knuckle
clr_knuckle = "#FCE300";   // color


// Default viewpoint for preview
//$vpr = [51, 0, 324]; $vpt = [1.4, 2.8, 3.1]; $vpd = 160;
// DEBUG - Top-down viewpoint for alignment checking
//$vpr = [0, 0, 0]; $vpt = [0, 0, 0]; $vpd = 200;

// Global variables
mid = height * ratio; // Mid-point for base
extrude = height-mid; // Extrude height

// The primary logic is here
module core_model() {
  // Reference image from original SVG for placement
  // reference_logo();
  color(clr_base)
    cylinder(d = size, h = mid, $fn = 128);

  // Accessories are extruded separately
  color(clr_base) linear_extrude(mid) {
    if (type == "buckle") {
      buckle(width = strap_width, offset = (size/2)-4, rotate = 90);
    }
    else if (type == "strap") {
      buckle(width = strap_width, offset = (size/2)-6, rotate = 0);
    }
    else if (type == "chain") {
      chain(height = mid, offset = size/2+3);
    } else {
      // Default coin, no accessories
    }
  }

  // The badge itself - Scaled and placed vertically
  resize([size*0.98, size*0.98])
    translate([0, 0, mid])
      badge();
}

module reference_logo() {
  // Top-down 
  # translate([0, -0, height]) linear_extrude(1)
      resize([size+1.2,size+14])
        import("bkglogo.svg", center=true);
}

// The extruded components, separated by color
module badge() {
  color(clr_text) linear_extrude(extrude) {
    // Frequency
    curved_text(freq, "Open Sans:bold", 34, 1, -40, 12, -254);
    curved_text("MHz", "Open Sans:bold", 35, 1, 19.2, 47.4, -252);
    // Callsign
    translate([0,-65])
    text(str(callsign," | #",number), size = 34, halign = "center", valign = "center", font="Open Sans:bold");
    curved_text("BRASS", "Open Sans:bold", 43, 1, 80, 28, 218);
    curved_text("KNUCKLE", "Open Sans:bold", 43, 1, 25, -47, 218);
    curved_text("GANG", "Open Sans:bold", 43, 1, -51, -94, 218);
  translate([0,-127])
    text("BKG", size = 62, halign = "center", valign = "center", font= "Rosario:bold", spacing = 1.06);
  }
  color(clr_highlights) linear_extrude(extrude) {
    ring(600, 22); // This changes the scale, do not touch
    ring(563, 12);
    ring(402, 14);
    curved_line(203, 219, 4, 234);
    curved_line(317, 336, 4, 234);
  }
  color(clr_knuckle) linear_extrude(extrude)
    knuckle();
}

// Curve text around the center, positive direction for cw, neg for ccw
module curved_text(string, font, size, spacing, start, end, offset){
  length = len(string);
  degrees = ((end - start) / length); // Degrees of spacing per-character
  for (i = [0 : length - 1]) {
    rotate([0, 0, (start+(degrees*i))])
      translate([0,offset])
           text(string[i], font = font, spacing = spacing, size = size, halign = "center");
  }
}

// Curved line - Assume CW rotation
module curved_line(start, end, width, offset) {
  steps = (end - start)/width; // Smoothness
  for (i = [0 : steps]) {
    a1 = start + (end - start) * (i / steps);
    a2 = start + (end - start) * ((i+1) / steps);
    
    hull() {
        translate([offset * cos(a1), offset * sin(a1), 0]) 
            circle(r = width);
        translate([offset * cos(a2), offset * sin(a2), 0]) 
            circle(r = width);
    }
  }
}

// Badge ring
module ring(size, width) {
  $fn = 64;
  difference() {
    circle(d = size);
    circle(d = size - width);
  }
}

